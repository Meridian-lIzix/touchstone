---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { reviewLd, abs } from '../../lib/seo';

// 详情页静态生成：每篇非草稿测评生成一个 slug 页面
export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

// Astro 把 getStaticPaths 里的 entry 注入 props，这里渲染正文并整理页面元数据
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const url = abs(`/reviews/${entry.id}`, Astro.site);
const dateStr = d.date.toISOString().slice(0, 10);
const coverAbs = d.cover ? abs(d.cover, Astro.site) : undefined;

// Review 结构化数据包含工具名、分类和评分
const ld = reviewLd({
  itemName: d.tool,
  category: d.category,
  description: d.dek,
  url,
  ratingValue: d.rating,
  datePublished: d.date.toISOString(),
  image: coverAbs,
});

// 顶部事实卡把用户最关心的价格、免费额度、访问和中文支持放在一起
const facts = [
  { label: '价格', value: d.pricing },
  { label: '免费额度', value: d.freeTier ? '有' : '无' },
  { label: '需要梯子', value: d.needsVpn ? '是' : '否' },
  { label: '中文支持', value: d.chinese },
];
---

<Base title={`${d.title} · Touchstone`} description={d.dek} image={d.cover} ogType="article" jsonLd={ld}>
  <article class="mx-auto max-w-4xl px-6 pt-14 pb-20">
    <a href="/reviews" class="ts-eyebrow hover:text-primary">← 工具测评</a>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="ts-eyebrow text-primary">{d.category}</span>
      {d.sample && (
        <span
          class="ts-eyebrow rounded-full border border-border px-2 py-0.5 text-muted"
          title="示例内容 · 上线时由站长替换为真实测评"
        >
          示例内容
        </span>
      )}
      <span class="ts-num text-xs text-muted">更新于 {dateStr}</span>
    </div>

    <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight sm:text-4xl">{d.title}</h1>
    <p class="mt-4 text-lg text-muted">{d.dek}</p>

    <div class={`mt-8 flex aspect-[16/9] items-center justify-center overflow-hidden rounded-xl border ${d.cover ? 'border-border' : 'border-dashed border-border'} bg-bg-subtle`}>
      {d.cover ? (
        <img src={d.cover} alt="" class="h-full w-full object-cover" loading="eager" />
      ) : (
        <span class="ts-eyebrow">实测截图 16:9</span>
      )}
    </div>

    <div class="mt-8 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2">
      {facts.map((f) => (
        <div class="flex items-center justify-between gap-4 bg-surface px-4 py-3">
          <span class="text-sm text-muted">{f.label}</span>
          <span class="text-sm font-medium">{f.value}</span>
        </div>
      ))}
      {d.rating != null && (
        <div class="flex items-center justify-between gap-4 bg-surface px-4 py-3">
          <span class="text-sm text-muted">站长评分</span>
          <span class="ts-num text-sm font-medium text-primary">{d.rating.toFixed(1)} / 10</span>
        </div>
      )}
      {d.link && (
        <div class="flex items-center justify-between gap-4 bg-surface px-4 py-3">
          <span class="text-sm text-muted">官网</span>
          <a href={d.link} target="_blank" rel="noopener" class="text-sm font-medium text-primary hover:underline">
            访问 ↗
          </a>
        </div>
      )}
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {d.pros.length > 0 && (
        <div class="ts-card p-5">
          <h2 class="ts-eyebrow text-good">优点</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {d.pros.map((p) => (
              <li class="flex gap-2"><span class="text-good">＋</span><span>{p}</span></li>
            ))}
          </ul>
        </div>
      )}
      {d.cons.length > 0 && (
        <div class="ts-card p-5">
          <h2 class="ts-eyebrow text-bad">短板</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {d.cons.map((c) => (
              <li class="flex gap-2"><span class="text-bad">－</span><span>{c}</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {d.bestFor.length > 0 && (
      <div class="ts-card mt-6 p-5">
        <h2 class="ts-eyebrow">适合谁</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {d.bestFor.map((b) => (
            <span class="rounded-full border border-border px-3 py-1 text-sm text-muted">{b}</span>
          ))}
        </div>
      </div>
    )}

    <div class="prose mt-12">
      <Content />
    </div>
  </article>
</Base>
