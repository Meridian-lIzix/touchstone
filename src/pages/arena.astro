---
import Base from '../layouts/Base.astro';
import ArenaVote from '../components/ArenaVote.tsx';
---

<Base
  title="盲评 Arena · 试金石 Touchstone"
  description="同一句提示词，两个匿名模型的作品，只凭作品本身选更好的那个。你的盲评实时喂给排行榜。"
>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-8">
    <p class="ts-eyebrow">Arena · 盲评</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold sm:text-5xl">盲评 Arena</h1>
    <p class="mt-4 max-w-[60ch] text-lg text-muted">
      两件作品出自同一句提示词、不同模型——但你看不到是谁。只凭作品本身选更好的那个；投完翻牌，
      你这一票实时进 <a href="/leaderboard" class="text-primary hover:underline">排行榜</a>。
    </p>
  </section>

  {/* 预留稳定高度：加载态与出对子后高度一致，进页面时滚动条不跳（消除"刷新"观感） */}
  <section class="mx-auto min-h-[44rem] max-w-5xl px-6 pb-20">
    {/* 盲评需要实时请求后端，因此首屏加载 React 岛组件 */}
    <ArenaVote client:load />
  </section>
</Base>
