---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { itemListLd, abs } from '../../lib/seo';

// 每个合集 Markdown 生成一个静态详情页
export async function getStaticPaths() {
  const items = await getCollection('collections', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

// 合集详情由 frontmatter 的 items 驱动工具流程，正文补充方法说明
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const url = abs(`/collections/${entry.id}`, Astro.site);
const dateStr = d.date.toISOString().slice(0, 10);

// 合集内工具也作为 ItemList 输出；有关联测评时链接到测评页
const ld = itemListLd({
  name: d.title,
  url,
  items: d.items.map((it) => ({
    name: it.tool,
    url: it.reviewSlug ? abs(`/reviews/${it.reviewSlug}`, Astro.site) : url,
  })),
});
---

<Base title={`${d.title} · 试金石 Touchstone`} description={d.dek} ogType="article" jsonLd={ld}>
  <article class="mx-auto max-w-4xl px-6 pt-14 pb-20">
    <a href="/collections" class="ts-eyebrow hover:text-primary">← 场景合集</a>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="ts-eyebrow text-primary">场景合集</span>
      {d.sample && (
        <span class="ts-eyebrow rounded-full border border-border px-2 py-0.5 text-muted" title="示例内容">示例内容</span>
      )}
      <span class="ts-num text-xs text-muted">更新于 {dateStr}</span>
    </div>

    <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight sm:text-4xl">{d.title}</h1>
    <p class="mt-3 ts-eyebrow text-muted">场景：{d.scenario}</p>
    <p class="mt-4 text-lg text-muted">{d.dek}</p>

    <ol class="mt-10 space-y-3">
      {d.items.map((it, i) => (
        <li class="ts-card flex items-start gap-4 p-5">
          <span class="ts-num font-serif text-2xl font-semibold leading-none text-primary">{i + 1}</span>
          <div class="flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-medium">{it.tool}</span>
              {it.reviewSlug && (
                <a href={`/reviews/${it.reviewSlug}`} class="ts-eyebrow text-primary hover:underline">看测评 →</a>
              )}
            </div>
            <p class="mt-1 text-sm text-muted">{it.role}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Base>
