# Touchstone — 构建产物与本地数据不进仓库
node_modules/
dist/
.astro/

# arena 后端本地数据库（SQLite）
server/*.db
server/*.db-*
server/*.bak

# 管理后台：本地数据库 + 本地上传的媒体文件
admin/*.db
admin/*.db-*
admin/uploads/

# 本地工具工作目录，不进仓库
.agents/
.codex/
.claude/

# 顶层 markdown 默认只留本地；下方显式放行要共享的文档。
# src/content 下的内容 .md 不受影响，照常跟踪。
/*.md
!/README.md
!/Touchstone 架构.md
!/Touchstone 设计系统.md
!/Touchstone Arena 机制.md
!/Touchstone 决策日志.md
!/Touchstone MOC.md
!/Touchstone 待办.md

# logs / os / editor
*.log
.DS_Store
Thumbs.db

# env
.env
.env.*
!.env.example
