{
  "name": "touchstone",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.mjs",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "dev:admin": "node --disable-warning=ExperimentalWarning --watch admin/index.mjs",
    "start:web": "node --disable-warning=ExperimentalWarning server/web.mjs",
    "dev:all": "concurrently -n web,api -c blue,green \"pnpm dev\" \"pnpm dev:api\""
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/source-serif-4": "^5.0.0",
    "@fontsource/geist-mono": "^5.0.0",
    "@hono/node-server": "^2.0.5",
    "astro": "^5.0.0",
    "astro-pagefind": "^2.0.0",
    "esbuild": "^0.27.7",
    "hono": "^4.12.25",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.0.0"
  }
}
